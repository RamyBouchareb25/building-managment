# Database
DATABASE_URL="postgresql://username:password@localhost:5432/building_funds_db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Optional: Email configuration for password reset
